<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1000 1000" width="100%" height="100%" style="background:#fdfcf9; font-family:system-ui, -apple-system, sans-serif;">
  <defs>
    <!-- Gradients -->
    <linearGradient id="bgGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#faf8f5"/>
      <stop offset="50%" stop-color="#ffffff"/>
      <stop offset="100%" stop-color="#f4f1eb"/>
    </linearGradient>
    <linearGradient id="silverPlate" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#e2e8f0"/>
      <stop offset="30%" stop-color="#ffffff"/>
      <stop offset="70%" stop-color="#cbd5e1"/>
      <stop offset="100%" stop-color="#94a3b8"/>
    </linearGradient>
    <linearGradient id="denimGrad" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" stop-color="#3b82f6"/>
      <stop offset="100%" stop-color="#1d4ed8"/>
    </linearGradient>
    <linearGradient id="skinGrad" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" stop-color="#f6c89f"/>
      <stop offset="100%" stop-color="#df9e6d"/>
    </linearGradient>
    <filter id="shadow" x="-5%" y="-5%" width="110%" height="110%">
      <feDropShadow dx="0" dy="4" stdDeviation="5" flood-color="#0f172a" flood-opacity="0.12"/>
    </filter>
    <filter id="bubbleShadow" x="-10%" y="-10%" width="120%" height="120%">
      <feDropShadow dx="1" dy="3" stdDeviation="4" flood-color="#000" flood-opacity="0.1"/>
    </filter>
  </defs>

  <!-- Background Canvas -->
  <rect width="1000" height="1000" fill="url(#bgGrad)"/>
  <rect x="12" y="12" width="976" height="976" rx="20" fill="none" stroke="#e2e8f0" stroke-width="2"/>

  <!-- Top Title Header -->
  <g text-anchor="middle">
    <!-- Action Sparks -->
    <path d="M 60 70 L 40 50 M 65 50 L 50 35 M 935 70 L 955 50 M 930 50 L 945 35" stroke="#0f172a" stroke-width="3" stroke-linecap="round"/>
    <text x="500" y="70" font-size="44" font-weight="950" fill="#0f172a" letter-spacing="3">PROCUREMENT MANAGER.</text>
    <text x="500" y="112" font-size="34" font-weight="800" fill="#1e3a8a" font-style="italic" letter-spacing="1">Everyone Wants Something Different!</text>
  </g>

  <!-- ROPES / TENSION LINES from Center (500, 480) radiating outward -->
  <!-- Left Side Ropes -->
  <path d="M 450 420 Q 320 300 230 220" stroke="#b45309" stroke-width="6" stroke-dasharray="10 4" fill="none"/>
  <path d="M 440 450 Q 280 380 180 340" stroke="#b45309" stroke-width="6" stroke-dasharray="10 4" fill="none"/>
  <path d="M 440 480 Q 280 470 190 460" stroke="#b45309" stroke-width="6" stroke-dasharray="10 4" fill="none"/>
  <path d="M 445 520 Q 300 560 210 590" stroke="#b45309" stroke-width="6" stroke-dasharray="10 4" fill="none"/>
  <path d="M 460 560 Q 320 640 230 680" stroke="#b45309" stroke-width="6" stroke-dasharray="10 4" fill="none"/>

  <!-- Right Side Ropes -->
  <path d="M 550 420 Q 680 300 770 220" stroke="#b45309" stroke-width="6" stroke-dasharray="10 4" fill="none"/>
  <path d="M 560 450 Q 720 380 820 340" stroke="#b45309" stroke-width="6" stroke-dasharray="10 4" fill="none"/>
  <path d="M 560 480 Q 720 470 810 460" stroke="#b45309" stroke-width="6" stroke-dasharray="10 4" fill="none"/>
  <path d="M 555 520 Q 700 560 790 590" stroke="#b45309" stroke-width="6" stroke-dasharray="10 4" fill="none"/>
  <path d="M 540 560 Q 680 640 770 680" stroke="#b45309" stroke-width="6" stroke-dasharray="10 4" fill="none"/>

  <!-- ======================================================== -->
  <!-- CENTER CHARACTER: MOHAMED SADIQ (Procurement Manager) -->
  <!-- ======================================================== -->
  <g transform="translate(500, 480)">
    <!-- Legs / Pants -->
    <path d="M -45 130 L -40 260 L -10 260 L -15 130 Z" fill="#1e293b"/>
    <path d="M 45 130 L 40 260 L 10 260 L 15 130 Z" fill="#1e293b"/>
    <path d="M -50 250 L -5 250 L -5 265 L -55 265 Z" fill="#0f172a" rx="4"/>
    <path d="M 50 250 L 5 250 L 5 265 L 55 265 Z" fill="#0f172a" rx="4"/>

    <!-- Denim Jacket Body -->
    <path d="M -65 20 C -60 -40, 60 -40, 65 20 L 70 140 L -70 140 Z" fill="url(#denimGrad)" filter="url(#shadow)"/>
    <!-- Collar & White T-Shirt -->
    <path d="M -25 -20 L 0 25 L 25 -20 Z" fill="#ffffff"/>
    <path d="M -60 -20 L -25 -20 L -10 20 L -45 20 Z" fill="#1d4ed8"/>
    <path d="M 60 -20 L 25 -20 L 10 20 L 45 20 Z" fill="#1d4ed8"/>

    <!-- Bound Crossed Arms with Denim Sleeves -->
    <path d="M -70 20 Q -40 80 0 75 Q 40 80 70 20 Q 60 70 30 95 Q 0 100 -30 95 Z" fill="#2563eb"/>
    <!-- Clenched Hands -->
    <ellipse cx="-15" cy="50" rx="14" ry="12" fill="url(#skinGrad)"/>
    <ellipse cx="15" cy="50" rx="14" ry="12" fill="url(#skinGrad)"/>

    <!-- ROPES TIED AROUND BODY (Heavy knots & wraps) -->
    <g stroke="#92400e" stroke-width="7" fill="none" stroke-linecap="round">
      <ellipse cx="0" cy="30" rx="66" ry="12"/>
      <ellipse cx="0" cy="55" rx="68" ry="12"/>
      <ellipse cx="0" cy="80" rx="65" ry="12"/>
      <ellipse cx="0" cy="105" rx="60" ry="12"/>
      <!-- Big Center Knot -->
      <circle cx="0" cy="52" r="14" fill="#b45309" stroke="#78350f" stroke-width="3"/>
      <path d="M -12 45 Q 0 55 12 45 M -10 60 Q 0 50 10 60" stroke="#78350f" stroke-width="3"/>
    </g>

    <!-- Head & Neck -->
    <rect x="-14" y="-35" width="28" height="25" fill="url(#skinGrad)" rx="5"/>
    <ellipse cx="0" cy="-60" rx="36" ry="42" fill="url(#skinGrad)"/>
    <!-- Black Hair -->
    <path d="M -38 -75 C -35 -105, 35 -105, 38 -75 C 40 -60, 36 -50, 34 -45 C 32 -70, -32 -70, -34 -45 C -36 -50, -40 -60, -38 -75 Z" fill="#0f172a"/>
    <!-- Beard & Mustache -->
    <path d="M -32 -60 C -30 -30, 30 -30, 32 -60 C 25 -40, -25 -40, -32 -60 Z" fill="#0f172a"/>
    <path d="M -15 -48 Q 0 -44 15 -48 Q 0 -42 -15 -48 Z" fill="#0f172a"/>
    <!-- Eyes, Eyebrows & Calm/Patient Expression -->
    <path d="M -22 -68 Q -14 -72 -6 -68" stroke="#0f172a" stroke-width="3.5" fill="none" stroke-linecap="round"/>
    <path d="M 6 -68 Q 14 -72 22 -68" stroke="#0f172a" stroke-width="3.5" fill="none" stroke-linecap="round"/>
    <ellipse cx="-14" cy="-60" rx="4" ry="4" fill="#0f172a"/>
    <ellipse cx="14" cy="-60" rx="4" ry="4" fill="#0f172a"/>
    <circle cx="-13" cy="-61" r="1.2" fill="#fff"/>
    <circle cx="15" cy="-61" r="1.2" fill="#fff"/>
    <!-- Nose & Resolute Smile -->
    <path d="M 0 -63 L 0 -52 L 4 -50" stroke="#c27d4c" stroke-width="2.5" fill="none" stroke-linecap="round"/>
    <path d="M -8 -40 Q 0 -36 8 -40" stroke="#9a3412" stroke-width="2.5" fill="none" stroke-linecap="round"/>
  </g>

  <!-- Center Subtitle Under Character -->
  <text x="500" y="750" text-anchor="middle" font-size="28" font-weight="900" fill="#0f172a">
    One Person. Many Expectations!
  </text>

  <!-- ======================================================== -->
  <!-- 10 STAKEHOLDER GROUPS WITH SPEECH BUBBLES -->
  <!-- ======================================================== -->

  <!-- 1. MANAGEMENT (Top Left) -->
  <g transform="translate(140, 190)" filter="url(#bubbleShadow)">
    <rect x="-110" y="-45" width="220" height="70" rx="16" fill="#ffffff" stroke="#cbd5e1" stroke-width="2"/>
    <polygon points="50,25 70,45 60,25" fill="#ffffff"/>
    <text x="0" y="-18" text-anchor="middle" font-size="12" font-weight="800" fill="#64748b" letter-spacing="1">MANAGEMENT</text>
    <text x="0" y="10" text-anchor="middle" font-size="18" font-weight="900" fill="#dc2626">"We need lower costs!"</text>
  </g>

  <!-- 2. FINANCE (Mid-Upper Left) -->
  <g transform="translate(130, 310)" filter="url(#bubbleShadow)">
    <rect x="-115" y="-42" width="230" height="72" rx="16" fill="#ffffff" stroke="#cbd5e1" stroke-width="2"/>
    <polygon points="65,28 85,46 75,28" fill="#ffffff"/>
    <text x="0" y="-16" text-anchor="middle" font-size="12" font-weight="800" fill="#64748b" letter-spacing="1">FINANCE &amp; AUDIT</text>
    <text x="0" y="12" text-anchor="middle" font-size="17" font-weight="900" fill="#b91c1c">"Approved budget please!"</text>
  </g>

  <!-- 3. BUSINESS PARTNERS (Mid Left) -->
  <g transform="translate(135, 435)" filter="url(#bubbleShadow)">
    <rect x="-120" y="-42" width="240" height="74" rx="16" fill="#ffffff" stroke="#cbd5e1" stroke-width="2"/>
    <polygon points="70,30 90,48 80,30" fill="#ffffff"/>
    <text x="0" y="-16" text-anchor="middle" font-size="12" font-weight="800" fill="#64748b" letter-spacing="1">BUSINESS PARTNERS</text>
    <text x="0" y="12" text-anchor="middle" font-size="16" font-weight="900" fill="#c2410c">"Can you negotiate better terms?"</text>
  </g>

  <!-- 4. INTERNAL TEAMS (Lower-Mid Left) -->
  <g transform="translate(140, 565)" filter="url(#bubbleShadow)">
    <rect x="-120" y="-42" width="240" height="74" rx="16" fill="#ffffff" stroke="#cbd5e1" stroke-width="2"/>
    <polygon points="65,30 85,48 75,30" fill="#ffffff"/>
    <text x="0" y="-16" text-anchor="middle" font-size="12" font-weight="800" fill="#64748b" letter-spacing="1">INTERNAL TEAMS / OPS</text>
    <text x="0" y="12" text-anchor="middle" font-size="16" font-weight="900" fill="#b45309">"We need more stock availability!"</text>
  </g>

  <!-- 5. MARKET & INDUSTRY (Bottom Left) -->
  <g transform="translate(150, 685)" filter="url(#bubbleShadow)">
    <rect x="-125" y="-42" width="250" height="72" rx="16" fill="#ffffff" stroke="#cbd5e1" stroke-width="2"/>
    <polygon points="60,-40 80,-55 70,-40" fill="#ffffff"/>
    <text x="0" y="-16" text-anchor="middle" font-size="12" font-weight="800" fill="#64748b" letter-spacing="1">MARKET &amp; INDUSTRY</text>
    <text x="0" y="12" text-anchor="middle" font-size="16" font-weight="900" fill="#b91c1c">"Keep an eye on market trends!"</text>
  </g>

  <!-- 6. SUPPLIERS (Top Right) -->
  <g transform="translate(860, 190)" filter="url(#bubbleShadow)">
    <rect x="-115" y="-45" width="230" height="70" rx="16" fill="#ffffff" stroke="#cbd5e1" stroke-width="2"/>
    <polygon points="-50,25 -70,45 -60,25" fill="#ffffff"/>
    <text x="0" y="-18" text-anchor="middle" font-size="12" font-weight="800" fill="#64748b" letter-spacing="1">TIER-1 SUPPLIERS</text>
    <text x="0" y="10" text-anchor="middle" font-size="18" font-weight="900" fill="#dc2626">"We need faster delivery!"</text>
  </g>

  <!-- 7. QUALITY & COMPLIANCE (Mid-Upper Right) -->
  <g transform="translate(865, 310)" filter="url(#bubbleShadow)">
    <rect x="-120" y="-42" width="240" height="74" rx="16" fill="#ffffff" stroke="#cbd5e1" stroke-width="2"/>
    <polygon points="-65,30 -85,48 -75,30" fill="#ffffff"/>
    <text x="0" y="-16" text-anchor="middle" font-size="12" font-weight="800" fill="#64748b" letter-spacing="1">QUALITY &amp; COMPLIANCE</text>
    <text x="0" y="12" text-anchor="middle" font-size="16" font-weight="900" fill="#7c2d12">"We need quality &amp; compliance!"</text>
  </g>

  <!-- 8. LOGISTICS (Mid Right) -->
  <g transform="translate(865, 435)" filter="url(#bubbleShadow)">
    <rect x="-115" y="-42" width="230" height="72" rx="16" fill="#ffffff" stroke="#cbd5e1" stroke-width="2"/>
    <polygon points="-65,28 -85,46 -75,28" fill="#ffffff"/>
    <text x="0" y="-16" text-anchor="middle" font-size="12" font-weight="800" fill="#64748b" letter-spacing="1">LOGISTICS &amp; YARD</text>
    <text x="0" y="12" text-anchor="middle" font-size="17" font-weight="900" fill="#ea580c">"We need on-time delivery!"</text>
  </g>

  <!-- 9. VENDORS / SUBCONTRACTORS (Lower-Mid Right) -->
  <g transform="translate(860, 565)" filter="url(#bubbleShadow)">
    <rect x="-115" y="-42" width="230" height="72" rx="16" fill="#ffffff" stroke="#cbd5e1" stroke-width="2"/>
    <polygon points="-65,28 -85,46 -75,28" fill="#ffffff"/>
    <text x="0" y="-16" text-anchor="middle" font-size="12" font-weight="800" fill="#64748b" letter-spacing="1">VENDORS / SUBCONTRACTORS</text>
    <text x="0" y="12" text-anchor="middle" font-size="17" font-weight="900" fill="#c2410c">"We need faster payments!"</text>
  </g>

  <!-- 10. LEADERSHIP & STRATEGY (Bottom Right) -->
  <g transform="translate(850, 685)" filter="url(#bubbleShadow)">
    <rect x="-120" y="-42" width="240" height="72" rx="16" fill="#ffffff" stroke="#cbd5e1" stroke-width="2"/>
    <polygon points="-60,-40 -80,-55 -70,-40" fill="#ffffff"/>
    <text x="0" y="-16" text-anchor="middle" font-size="12" font-weight="800" fill="#64748b" letter-spacing="1">EXECUTIVE LEADERSHIP</text>
    <text x="0" y="12" text-anchor="middle" font-size="17" font-weight="900" fill="#991b1b">"Drive strategic value!"</text>
  </g>

  <!-- ======================================================== -->
  <!-- BOTTOM 7 CORE COMPETENCY PILLARS -->
  <!-- ======================================================== -->
  <g transform="translate(50, 785)">
    <!-- 7 Columns -->
    <g transform="translate(30, 0)">
      <circle cx="15" cy="15" r="16" fill="#eff6ff" stroke="#3b82f6" stroke-width="2"/>
      <text x="15" y="21" text-anchor="middle" font-size="16">🤝</text>
      <text x="15" y="44" text-anchor="middle" font-size="10" font-weight="900" fill="#0f172a">NEGOTIATION</text>
      <text x="15" y="56" text-anchor="middle" font-size="10" font-weight="900" fill="#0f172a">SKILLS</text>
    </g>

    <line x1="95" y1="5" x2="95" y2="55" stroke="#cbd5e1" stroke-width="1.5"/>

    <g transform="translate(160, 0)">
      <circle cx="15" cy="15" r="16" fill="#eff6ff" stroke="#3b82f6" stroke-width="2"/>
      <text x="15" y="21" text-anchor="middle" font-size="16">⚙️</text>
      <text x="15" y="44" text-anchor="middle" font-size="10" font-weight="900" fill="#0f172a">SUPPLY CHAIN</text>
      <text x="15" y="56" text-anchor="middle" font-size="10" font-weight="900" fill="#0f172a">MANAGEMENT</text>
    </g>

    <line x1="225" y1="5" x2="225" y2="55" stroke="#cbd5e1" stroke-width="1.5"/>

    <g transform="translate(290, 0)">
      <circle cx="15" cy="15" r="16" fill="#eff6ff" stroke="#3b82f6" stroke-width="2"/>
      <text x="15" y="21" text-anchor="middle" font-size="16">📋</text>
      <text x="15" y="44" text-anchor="middle" font-size="10" font-weight="900" fill="#0f172a">VENDOR</text>
      <text x="15" y="56" text-anchor="middle" font-size="10" font-weight="900" fill="#0f172a">MANAGEMENT</text>
    </g>

    <line x1="355" y1="5" x2="355" y2="55" stroke="#cbd5e1" stroke-width="1.5"/>

    <g transform="translate(420, 0)">
      <circle cx="15" cy="15" r="16" fill="#eff6ff" stroke="#3b82f6" stroke-width="2"/>
      <text x="15" y="21" text-anchor="middle" font-size="16">💰</text>
      <text x="15" y="44" text-anchor="middle" font-size="10" font-weight="900" fill="#0f172a">COST</text>
      <text x="15" y="56" text-anchor="middle" font-size="10" font-weight="900" fill="#0f172a">OPTIMIZATION</text>
    </g>

    <line x1="485" y1="5" x2="485" y2="55" stroke="#cbd5e1" stroke-width="1.5"/>

    <g transform="translate(550, 0)">
      <circle cx="15" cy="15" r="16" fill="#eff6ff" stroke="#3b82f6" stroke-width="2"/>
      <text x="15" y="21" text-anchor="middle" font-size="16">🔄</text>
      <text x="15" y="44" text-anchor="middle" font-size="10" font-weight="900" fill="#0f172a">PROCESS</text>
      <text x="15" y="56" text-anchor="middle" font-size="10" font-weight="900" fill="#0f172a">IMPROVEMENT</text>
    </g>

    <line x1="615" y1="5" x2="615" y2="55" stroke="#cbd5e1" stroke-width="1.5"/>

    <g transform="translate(680, 0)">
      <circle cx="15" cy="15" r="16" fill="#eff6ff" stroke="#3b82f6" stroke-width="2"/>
      <text x="15" y="21" text-anchor="middle" font-size="16">🎯</text>
      <text x="15" y="44" text-anchor="middle" font-size="10" font-weight="900" fill="#0f172a">STRATEGIC</text>
      <text x="15" y="56" text-anchor="middle" font-size="10" font-weight="900" fill="#0f172a">SOURCING</text>
    </g>

    <line x1="745" y1="5" x2="745" y2="55" stroke="#cbd5e1" stroke-width="1.5"/>

    <g transform="translate(810, 0)">
      <circle cx="15" cy="15" r="16" fill="#eff6ff" stroke="#3b82f6" stroke-width="2"/>
      <text x="15" y="21" text-anchor="middle" font-size="16">👥</text>
      <text x="15" y="44" text-anchor="middle" font-size="10" font-weight="900" fill="#0f172a">STAKEHOLDER</text>
      <text x="15" y="56" text-anchor="middle" font-size="10" font-weight="900" fill="#0f172a">MANAGEMENT</text>
    </g>
  </g>

  <!-- ======================================================== -->
  <!-- BRUSHED SILVER NAMEPLATE: MOHAMED SADIQ -->
  <!-- ======================================================== -->
  <g transform="translate(500, 895)">
    <!-- Plate Background with Screws -->
    <rect x="-190" y="-30" width="380" height="60" rx="8" fill="url(#silverPlate)" stroke="#64748b" stroke-width="3" filter="url(#shadow)"/>
    <circle cx="-170" cy="0" r="4.5" fill="#475569" stroke="#94a3b8" stroke-width="1.5"/>
    <circle cx="170" cy="0" r="4.5" fill="#475569" stroke="#94a3b8" stroke-width="1.5"/>
    <line x1="-173" y1="-3" x2="-167" y2="3" stroke="#cbd5e1" stroke-width="1.5"/>
    <line x1="167" y1="-3" x2="173" y2="3" stroke="#cbd5e1" stroke-width="1.5"/>
    <text x="0" y="9" text-anchor="middle" font-size="34" font-weight="950" fill="#0f172a" letter-spacing="2">
      Mohamed Sadiq
    </text>
  </g>

  <!-- ======================================================== -->
  <!-- BOTTOM MOTTO BANNER -->
  <!-- ======================================================== -->
  <text x="500" y="965" text-anchor="middle" font-size="22" font-weight="900" fill="#0284c7" font-style="italic" letter-spacing="1">
    Right Product. Right Quality. Right Time. Right Cost. Always!
  </text>
</svg>
